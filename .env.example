# Managarr configuration.
# Copy to `.env` and edit. Any setting left out uses the default shown here,
# so `docker compose up` also works without this file.

# ─── Docker Compose: host side ──────────────────────────────────────────────
# Host port the web UI is published on.
MANAGARR_PORT=8000
# Host folders mounted into the container. Downloads and library folders should
# be on the same filesystem (and the same paths qBittorrent sees) so imports
# can hardlink instead of copying.
CONFIG_DIR_HOST=./data/config
MOVIES_DIR=./data/movies
NEW_MOVIES_DIR=./data/new-movies
TV_DIR=./data/tv
AUDIOBOOKS_DIR=./data/audiobooks
DOWNLOADS_DIR=./data/downloads
# Folder that holds Libation's LibationContext.db (Audible sync; optional).
LIBATION_DIR=./data/libation

# ─── Database (PostgreSQL) ──────────────────────────────────────────────────
# Used both to initialise the bundled postgres container and by Managarr to
# connect. Change the password before first start; it's baked into the volume.
POSTGRES_USER=managarr
POSTGRES_PASSWORD=managarr
POSTGRES_DB=managarr
# Outside Compose (bare-metal / your own Postgres) also set host and port:
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# Or give a full SQLAlchemy URL, which overrides all POSTGRES_* values:
# DATABASE_URL=

# ─── Auth ────────────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
# Blank = a random password is generated on first start, printed in the logs
# and saved to <config>/admin_password.
ADMIN_PASSWORD=
# Blank = a random signing key is generated and saved to <config>/.jwt_secret.
JWT_SECRET=

# ─── General ─────────────────────────────────────────────────────────────────
TZ=UTC
LOG_LEVEL=INFO
# Languages an audiobook metadata match may be in (comma-separated; blank = any).
METADATA_LANGUAGES=english
ENABLE_SCHEDULER=true
ENABLE_MCP=true

# ─── Paths inside the container ──────────────────────────────────────────────
# Only change these when running outside Docker; Compose mounts the *_DIR
# folders above at these paths.
# CONFIG_DIR=/config
# SCRIPTS_DIR=/config/scripts
# MOVIES_PATH=/movies
# NEW_MOVIES_PATH=/new-movies
# TV_PATH=/tv
# AUDIOBOOKS_PATH=/audiobooks
# DOWNLOADS_PATH=/downloads
# LIBATION_DB_PATH=/db/LibationContext.db
# STATIC_DIR=/app/static

# ─── qBittorrent ─────────────────────────────────────────────────────────────
QBT_HOST=qbittorrent
QBT_PORT=8080
QBT_USERNAME=
QBT_PASSWORD=
QBT_CATEGORY=managarr
# Blank = qBittorrent's own default.
QBT_SEED_RATIO=
# none | top | bottom
QBT_QUEUE_PRIORITY=none
QBT_FORCE_START=false
# Master switch: false = nothing is ever sent to qBittorrent.
DOWNLOADS_ENABLED=true
# false = scheduled jobs find releases but never download (manual grabs still work).
AUTO_DOWNLOAD_ENABLED=true
AUTO_DOWNLOAD_MAX_CONCURRENT=5
AUTO_DOWNLOAD_SYNC_INTERVAL_MINUTES=30
AUTO_DOWNLOAD_MAX_ATTEMPTS=5
CALENDAR_AUTO_GRAB_MAX_AGE_DAYS=14

# ─── Indexers ────────────────────────────────────────────────────────────────
# HTTP proxy for all tracker traffic (e.g. gluetun's http://gluetun:8888). Blank = direct.
GLUETUN_PROXY_URL=
# MyAnonamouse session cookie (the mbsc value), or a Mousehole instance to read it from.
MAM_COOKIE=
MOUSEHOLE_URL=
# IPTorrents session cookie: "uid=...; pass=..."
IPT_COOKIE=

# ─── Metadata providers ──────────────────────────────────────────────────────
TMDB_API_KEY=
TVDB_API_KEY=

# ─── Plex (optional: watchlist sync, library scans, watched mover) ───────────
PLEX_URL=
PLEX_TOKEN=
MOVIES_LIBRARY=Movies
NEW_MOVIES_LIBRARY=New Movies
MOVE_TIMEOUT_SEC=900

# ─── Audiobookshelf (optional: rescan after audiobook imports) ───────────────
ABS_URL=
ABS_TOKEN=
# Library name; blank = first book library.
ABS_LIBRARY=

# ─── Radarr (optional: one-time import of movie collections) ─────────────────
RADARR_URL=
RADARR_API_KEY=

# ─── Notifications (ntfy) ────────────────────────────────────────────────────
NTFY_URL=
NTFY_TOPIC=managarr
NTFY_TOKEN=

# ─── External jobs registry (optional) ───────────────────────────────────────
JOBS_REGISTRY_URL=
JOBS_REGISTRY_TOKEN=

# ─── Library scan ────────────────────────────────────────────────────────────
SCAN_PROBE_CODEC=false
SCAN_BATCH=100

# ─── Transcoding (CPU HEVC) and m4b conversion ───────────────────────────────
TRANSCODE_CRF=21
TRANSCODE_PRESET=medium
TRANSCODE_THREADS=4
TRANSCODE_MAX_CONCURRENT=1
# e.g. 01:00-07:00; blank = any time.
TRANSCODE_WINDOW=
M4B_BITRATE=64k
M4B_MAX_CONCURRENT=1
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# ─── Copy-to-device (SMB) ────────────────────────────────────────────────────
DEVICE_COPY_MAX_CONCURRENT=1
DEVICE_FREE_HEADROOM_MB=500
