# ── Core ────────────────────────────────────────────────
# Must match POSTGRES_PASSWORD below. Format: postgresql+psycopg://USER:PASSWORD@HOST:5432/DB
POSTGRES_PASSWORD=
DATABASE_URL=
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
TZ=UTC
LOG_LEVEL=INFO

# ── Library roots (paths inside the container) ──────────
MOVIES_PATH=/movies
NEW_MOVIES_PATH=/new-movies
TV_PATH=/tv
AUDIOBOOKS_PATH=/audiobooks
DOWNLOADS_PATH=/downloads
METADATA_LANGUAGES=english

# ── qBittorrent ─────────────────────────────────────────
QBT_HOST=qbittorrent
QBT_PORT=8080
QBT_USERNAME=
QBT_PASSWORD=
QBT_CATEGORY=managarr
DOWNLOADS_ENABLED=true
AUTO_DOWNLOAD_ENABLED=true

# ── Indexers ────────────────────────────────────────────
# HTTP proxy for tracker traffic (e.g. gluetun's HTTP proxy). Blank = direct.
GLUETUN_PROXY_URL=
MAM_COOKIE=
MOUSEHOLE_URL=
IPT_COOKIE=

# ── Metadata ────────────────────────────────────────────
TMDB_API_KEY=
TVDB_API_KEY=

# ── Optional integrations (blank = disabled) ────────────
PLEX_URL=
PLEX_TOKEN=
ABS_URL=
ABS_TOKEN=
ABS_LIBRARY=
RADARR_URL=
RADARR_API_KEY=
NTFY_URL=
NTFY_TOPIC=managarr
NTFY_TOKEN=
LIBATION_DB_PATH=/db/LibationContext.db
